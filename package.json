  "description": "Roster — a weekly-clearing dating market (React Native / Expo). Mechanism Spec v5.2.2.",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.7",
    "expo": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-svg": "^15.13.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright-core": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:engine": "tsx src/engine/__smoke__.ts",
